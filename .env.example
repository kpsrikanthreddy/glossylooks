# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server Port (Default is 3000)
PORT=3000

# SUPABASE / POSTGRESQL CONFIGURATION (Optional - defaults to persistent JSON repository if not configured)
# Run /database/supabase_schema.sql in your Supabase SQL editor to create all tables and policies.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# POS & THERMAL PRINT AGENT CONFIGURATION
PRINT_AGENT_SECRET="glossy_print_secret_2025"
DEFAULT_PRINT_DEVICE_ID="DEV-001"

# META WHATSAPP BUSINESS EMBEDDED SIGNUP & COEXISTENCE
META_APP_ID="your_meta_app_id"
META_EMBEDDED_SIGNUP_CONFIG_ID="your_embedded_signup_config_id"
# Server-only Meta secrets (never exposed to frontend or client bundle)
META_APP_SECRET="your_meta_app_secret"
META_BUSINESS_ID="your_meta_business_portfolio_id"
META_SYSTEM_USER_ACCESS_TOKEN="your_meta_system_user_access_token"
META_VERIFY_TOKEN="your_meta_webhook_verify_token"
WHATSAPP_API_VERSION="v22.0"
# Delay after a completed appointment before the automated feedback template is sent.
FEEDBACK_DELAY_MINUTES="30"
# This must be the publicly deployed HTTPS endpoint, not the AI Studio editor
# URL. The server handles GET verification and POST WhatsApp events here.
META_WEBHOOK_CALLBACK_URL="https://www.glossylooks.in/api/whatsapp/webhook"
GOOGLE_REVIEW_URL="https://g.page/r/CTx5NddxkeKaEAE/review"


# REQUIRED for secure salon admin sessions (server-only; 32+ random characters)
SALON_SESSION_SECRET=
# SMAV integration uses the scoped backend key, never SMAV service_role credentials.
SMAV_SUPABASE_URL=https://qykdwswatopylzvqhgog.supabase.co
GLOSSYLOOKS_INTEGRATION_KEY=
SMAV_SUPABASE_ANON_KEY=
